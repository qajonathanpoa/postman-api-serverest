											"    pm.response.to.have.status(200);\r",
											"});\r",
											"\r",
											"// 2. Validar mensagem de exclusão realizada\r",
											"pm.test(\"Validar mensagem de registro excluído\", function () {\r",
											"    const jsonData = pm.response.json();\r",
											"    pm.expect(jsonData.message).to.eql(\"Registro excluído com sucesso\");\r",
											"});\r",
											"\r",
											"// 3. Limpar a variável de ambiente (opcional, para organização)\r",
											"pm.environment.unset(\"usuario_id\");"
										],
										"type": "text/javascript",
