							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"// 1. Validar Status Code 200 (OK)\r",
											"pm.test(\"Status code é 200\", function () {\r",
											"    pm.response.to.have.status(200);\r",
											"});\r",
											"\r",
											"// 2. Validar mensagem de sucesso na alteração\r",
											"pm.test(\"Validar mensagem de registro alterado\", function () {\r",
											"    const jsonData = pm.response.json();\r",
											"    pm.expect(jsonData.message).to.eql(\"Registro alterado com sucesso\");\r",
											"});\r",
											"\r",
											"// 3. Validar tempo de resposta\r",
											"pm.test(\"Tempo de resposta amigável (abaixo de 300ms)\", function () {\r",
											"    pm.expect(pm.response.responseTime).to.be.below(300);\r",
											"});"
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
